{
  "name": "@masatomakino/raf-ticker",
  "version": "0.7.0",
  "description": "Simple ticker with requestAnimationFrame.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "default": "./esm/index.js"
    }
  },
  "types": "esm/index.d.ts",
  "files": [
    "esm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://MasatoMakino@github.com/MasatoMakino/RAF-ticker.git"
  },
  "author": "MasatoMakino <unagiinu.g@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "eventemitter3": "^5.0.1"
  },
  "devDependencies": {
    "@masatomakino/demo-showcase": "^0.1.2",
    "@vitest/coverage-istanbul": "^5.0.3",
    "jsdom": "^30.1.1",
    "prettier": "^3.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "scripts": {
    "test": "vitest",
    "coverage": "vitest --coverage --run",
    "start:dev": "pnpm run server & pnpm run watch:tsc",
    "build": "pnpm run buildTS && pnpm run demo",
    "demo": "demo-showcase build --distDir ./docs/demo",
    "buildTS": "tsc",
    "server": "demo-showcase dev --host 0.0.0.0 --port 3456",
    "watch:tsc": "tsc -W --incremental",
    "pre-commit": "prettier --write --ignore-unknown",
    "pre-push": "vitest --run && pnpm run buildTS"
  },
  "bugs": {
    "url": "https://github.com/MasatoMakino/RAF-ticker/issues"
  },
  "homepage": "https://github.com/MasatoMakino/RAF-ticker#readme",
  "directories": {
    "doc": "docs",
    "esm": "esm"
  }
}
